{
  "expo": {
    "name": "NoWoo",
    "slug": "nowoo",
    "scheme": "com.nowoo.app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/ios-icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/ios-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2d3748"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/ios-icon.png",
      "buildNumber": "1",
      "bundleIdentifier": "com.nowoo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-adaptive-icon-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "icon": "./assets/android-icon.png",
      "package": "com.nowoo.app",
      "versionCode": 3145747
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "androidStatusBar": {
      "hidden": true
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "hidden",
          "behavior": "overlay-swipe",
          "backgroundColor": "#00000080"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NoWoo to access your photos to choose a background image."
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/audio/cuebell1.mp3"
          ]
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.102876587020-1cd8tgd9jf8hnmo2tvasru4q2p1tc2gd"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/ios-icon.png",
      "color": "#2d3748",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "NoWoo"
    },
    "extra": {
      "expo-navigation-bar": {
        "position": "absolute",
        "visibility": "hidden",
        "behavior": "overlay-swipe",
        "backgroundColor": "#00000080"
      },
      "eas": {
        "projectId": "d65cea1d-abe6-49bf-9533-c52822e31ec1"
      }
    },
    "owner": "r3app"
  }
}
